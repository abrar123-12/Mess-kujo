# সিকিউরিটি যাচাই (CAPTCHA) — শুধু একটা লাগবে, দুটো না!
# Cloudflare Turnstile: dash.cloudflare.com → Turnstile থেকে Site Key নিন
# খালি রাখলে CAPTCHA বন্ধ থাকবে, সাইট আগের মতোই চলবে
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# hCaptcha (বিকল্প): hcaptcha.com → Sites থেকে Site Key নিন
# Turnstile-এর বদলে এটা ব্যবহার করতে চাইলে শুধু এটা বসান (উপরেরটা খালি রাখুন)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

